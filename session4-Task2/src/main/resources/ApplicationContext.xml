<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
          http://www.springframework.org/schema/beans
          http://www.springframework.org/schema/beans/spring-beans.xsd
          http://www.springframework.org/schema/context
          http://www.springframework.org/schema/context/spring-context.xsd">


    <bean id="draw2d" class="com.myprojects.Draw2D"/>
    <bean id="draw3d" class="com.myprojects.Draw3D"/>


    <bean id="circle" class="com.myprojects.Circle" scope="singleton">
        <constructor-arg ref="draw2d"/>
        <constructor-arg ref="draw3d"/>
    </bean>



    <bean id="rectangle" class="com.myprojects.Rectangle" scope="prototype">
        <property name="draw2D" ref="draw2d"/>
        <property name="draw3D" ref="draw3d"/>
    </bean>



    <bean id="databaseOperations"
          class="com.myprojects.DatabaseOperations"
          init-method="connectToDatabase"
          destroy-method="disconnectFromDatabase"/>


</beans>
